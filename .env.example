# Context Slicer local configuration.
# Copy this file to .env and fill in the Gemini key before using Analyze.
GEMINI_API_KEY="isi_api_key_gemini"
GEMINI_MODEL="gemini-3.5-flash-lite"
PORT=3333

# Leave empty when ffmpeg is already available on PATH.
FFMPEG_PATH=""

# Model selection for caption generation is available in the Export UI.
MAX_UPLOAD_GB=4

# Optional override. Server automatically checks project .venv/venv first,
# then falls back to Python on PATH.
# PYTHON_PATH="C:\\Python311\\python.exe"
# YTDLP_PATH="C:\\Python311\\Scripts\\yt-dlp.exe"

# Optional URL used by the other VEXO views when deployed.
# APP_URL="http://localhost:3333"
